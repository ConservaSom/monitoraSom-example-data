# =============================================================================
# Non-example files — keep out of version control.
# The example data (recordings, sidecars, rois.duckdb, walkthroughs) and the
# repo docs (MANIFEST.csv, README.md, STATUS.md, AGENTS.md) stay tracked.
# Everything a package function can rebuild, plus tooling and session cruft,
# is ignored. See harness/clean_examples.sh for the byproduct names.
# =============================================================================

# Maintenance tooling. harness/ IS tracked: it holds the checks that keep the
# stores honest (ep_verify/ep_sync_signals), so an untracked harness meant the
# guard against a bug could not be versioned alongside the fix for it.
# It is still never a pack member - EP_EXCLUDE_TOP keeps it out of MANIFEST.csv
# and ep_tar(), so it is not distributed with the examples.
.claude/
.pi/

# R session temp dir (needs a writable TMPDIR; gitignored)
.tmp_R/

# Regenerable byproducts (see clean_examples.sh BYPRODUCTS)
templates/
roi_cuts/
app_presets/
soundscapes_metadata.duckdb
annotations/
detections/

# Quarto / knitr render output
**/_freeze/
**/_output/
**/.quarto/
**/*_files/
**/*_cache/
*.html

# Bundles produced by ep_tar()
/*.tar.gz

# R session cruft
.Rhistory
.RData
.Rproj.user/

# OS / editor cruft
.DS_Store
*~
*.swp

AGENTS.md
# generated release bundles (regenerable via ep_tar; not repo members)
outputs/
